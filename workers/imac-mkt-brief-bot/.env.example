# 아이맥의 /Users/pola/day1design-mkt-bot/.env 에 둔다. 권한은 600.
# 실제 값은 커밋하지 않는다.

# BotFather 로 만든 봇 토큰 (@day1_mkteff_bot)
DAY1_MKT_BOT_TOKEN=

# 비공개 그룹 chat_id. 관리자 지정 순간 슈퍼그룹으로 승격되며 값이 바뀐다
# (일반 그룹 -5569759697 → 슈퍼그룹 -1004350998116). 바뀐 값을 쓴다
DAY1_MKT_CHAT_ID=-100...

# 워커 /api/brief/marketing 인증. 워커 쪽에도 같은 값을 넣는다
#   printf "%s" "<값>" | npx wrangler secret put BRIEF_SECRET
BRIEF_SECRET=

# 반드시 api 호스트. day1design.co.kr 로 부르면 Vercel 이 404 를 낸다
BRIEF_API=https://api.day1design.co.kr

# 아래는 기본값이 있어 생략 가능
# CLAUDE_BIN=/Users/pola/.local/bin/claude
# CODEX_BIN=/Users/pola/.local/bin/codex
# CODEX_MODEL=gpt-5.6-sol
