# 실제 값은 프로젝트 루트 .env.imac-meta-lead.local 에만 둔다(커밋 금지).
# 배포: node scripts/deploy-imac-meta-lead-poller.mjs --run

# leads_retrieval 권한 + 페이지 '잠재 고객 액세스' 가 할당된 시스템 사용자 토큰.
# 광고 통계용 META_AD_ACCESS_TOKEN 과 다를 수 있으니 반드시 권한 확인 후 사용.
META_SYSTEM_USER_TOKEN=

# 인스턴트폼 ID(콤마 구분). 2026-07-25 기준 day1design 활성 폼: 1332988105550524
META_LEAD_FORM_IDS=1332988105550524

# Make 시나리오를 끈 시각(ISO). 이 시각 이전 리드는 재발송하지 않는다.
META_LEAD_CUTOVER_AT=

# day1design 워커 수신 엔드포인트 + 시크릿(= 워커의 META_LEAD_SECRET 과 동일 값)
LEAD_WEBHOOK_URL=https://api.day1design.co.kr/api/meta-lead
LEAD_WEBHOOK_SECRET=

# 폴러가 워커에 닿지 못할 때 직접 쏘는 알림 — 인프라봇 채널
HEALTH_TELEGRAM_BOT_TOKEN=
HEALTH_TELEGRAM_CHAT_ID=-1004487628453

# 선택
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_LEAD_LOOKBACK_HOURS=48
META_LEAD_OVERLAP_HOURS=48
META_LEAD_MAX_PAGES=10
